---
// @ts-nocheck
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const vaultPath = path.join(process.cwd(), '../vault');
const curriculumPath = path.join(vaultPath, 'curriculum.md');
let title = "고등학교 1학년 수학";
let parsedContent: string = "";

// Helper to recursively get all markdown files in vault
function getVaultFiles(dir: string): { relativePath: string; basename: string; fullPath: string }[] {
	let results: any[] = [];
	if (!fs.existsSync(dir)) return results;
	const list = fs.readdirSync(dir);
	for (const file of list) {
		const fullPath = path.join(dir, file);
		const stat = fs.statSync(fullPath);
		if (stat && stat.isDirectory()) {
			results = results.concat(getVaultFiles(fullPath));
		} else if (file.endsWith('.md') && file !== 'curriculum.md' && file !== '01-exam.md') {
			const relativePath = path.relative(vaultPath, fullPath);
			const basename = path.basename(file, '.md');
			results.push({ relativePath: relativePath.replace(/\\/g, '/').replace('.md', ''), basename, fullPath });
		}
	}
	return results;
}

const allFiles = getVaultFiles(vaultPath);

function parseWikiLinks(text: string) {
	return text.replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, (match, slug, label) => {
		const targetLabel = label || slug;
		const trimmedSlug = slug.trim();
		const matchedFile = allFiles.find(f => f.basename === trimmedSlug || f.relativePath === trimmedSlug);
		if (matchedFile) {
			return `<a href="/h1_math_c1/study/${matchedFile.relativePath}" class="wiki-link">${targetLabel}</a>`;
		}
		return `<span class="wiki-link-broken" title="문서가 존재하지 않습니다.">${targetLabel}</span>`;
	});
}

if (fs.existsSync(curriculumPath)) {
	const rawContent = fs.readFileSync(curriculumPath, 'utf-8');
	const lines = rawContent.split('\n');
	
	if (lines[0].startsWith('# ')) {
		title = lines[0].replace('# ', '').trim();
		parsedContent = lines.slice(1).join('\n').trim();
	} else {
		parsedContent = rawContent;
	}

	// Parsing Markdown to customized Analogue Print HTML
	parsedContent = parsedContent
		.replace(/## (.*)/g, '<div class="unit-section"><h2 class="unit-title">$1</h2></div>')
		.replace(/^\d+\.\s+(.*)/gm, '<h3 class="subunit-title">$1</h3>')
		.replace(/\* (.*)/g, '<li class="toc-item"><span class="toc-bullet">─</span><span class="toc-text">$1</span></li>');

	parsedContent = parseWikiLinks(parsedContent);
}
---

<Layout title={title}>
	<div class="paper-stack">
		<div class="paper" id="page-curriculum">
			<div class="content-border">
				<header class="curriculum-header">
					<div class="header-top">
						<span class="textbook-label">고등학교 공통수학 Ⅰ</span>
						<span class="page-num">01</span>
					</div>
					<h1 class="curriculum-title">목 차</h1>
					<p class="curriculum-desc">수학적 사고력을 기르고 핵심 개념을 완벽하게 이해하기 위한 교과 과정 안내입니다.</p>
				</header>

				<div class="curriculum-body">
					<div class="toc-content" set:html={parsedContent}></div>
				</div>

				<footer class="curriculum-footer">
					<div class="footer-row">
						<span class="brand">대한민국 수학교육 프로젝트</span>
						<span class="copy">ⓒ 2026 Mathematics Education All Rights Reserved</span>
					</div>
				</footer>
			</div>
		</div>
	</div>
</Layout>

<style>
	.paper-stack {
		display: flex;
		justify-content: center;
		width: 100%;
	}

	.curriculum-header {
		border-bottom: 2px solid #333333;
		padding-bottom: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.header-top {
		display: flex;
		justify-content: space-between;
		font-family: 'Noto Serif KR', serif;
		font-size: 0.85rem;
		color: #555555;
		font-weight: 500;
		letter-spacing: 0.05em;
		margin-bottom: 1.2rem;
	}

	.curriculum-title {
		font-family: 'Noto Serif KR', serif;
		font-size: 2.4rem;
		font-weight: 800;
		margin: 0;
		color: #1a1a1a;
		letter-spacing: 0.1em;
		line-height: 1.3;
		text-align: center;
	}

	.curriculum-desc {
		font-family: 'Noto Serif KR', serif;
		font-size: 0.95rem;
		color: #555555;
		margin: 1.1rem 0 0 0;
		line-height: 1.6;
		text-align: center;
	}

	.curriculum-body {
		min-height: 140mm;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		font-family: 'Noto Serif KR', serif;
	}

	:global(.unit-section) {
		margin-top: 2.2rem;
		margin-bottom: 1.2rem;
		border-bottom: 1px solid #1a1a1a;
		padding-bottom: 0.4rem;
	}
	:global(.unit-section:first-of-type) {
		margin-top: 0.2rem;
	}

	:global(.unit-title) {
		font-family: 'Noto Serif KR', serif;
		font-size: 1.6rem;
		font-weight: 800;
		color: #1a1a1a;
		margin: 0;
		letter-spacing: -0.01em;
	}

	:global(.subunit-title) {
		font-family: 'Noto Serif KR', serif;
		font-size: 1.15rem;
		font-weight: 700;
		color: #2c2c2c;
		margin: 1.4rem 0 0.8rem 0.2rem;
		letter-spacing: -0.01em;
	}

	:global(.toc-item) {
		list-style: none;
		margin-left: 1rem;
		margin-bottom: 0.6rem;
		display: flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 1.05rem;
	}

	:global(.toc-bullet) {
		font-size: 0.8rem;
		color: #777777;
		display: flex;
		align-items: center;
	}

	:global(.toc-text) {
		color: #1a1a1a;
	}

	:global(.wiki-link) {
		color: #1a1a1a;
		text-decoration: none;
		font-weight: 600;
		border-bottom: 1px solid #1a1a1a;
		transition: all 0.2s;
		padding: 0 1px;
	}

	:global(.wiki-link:hover) {
		color: #555555;
		background: #f4efdf;
	}

	:global(.wiki-link-broken) {
		color: #777777;
		font-weight: 500;
		cursor: help;
		border-bottom: 1px dashed #777777;
	}

	.curriculum-footer {
		margin-top: auto;
		padding-top: 1.5rem;
		border-top: 1px solid #dfd7c7;
	}
	.footer-row {
		display: flex;
		justify-content: space-between;
		font-size: 0.8rem;
		font-weight: 500;
		color: #555555;
	}
</style>
