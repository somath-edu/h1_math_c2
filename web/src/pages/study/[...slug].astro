---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
import katex from 'katex';

export async function getStaticPaths() {
	const vaultPath = path.join(process.cwd(), '../vault');
	if (!fs.existsSync(vaultPath)) return [];

	function getFiles(dir: string): any[] {
		let results: any[] = [];
		const list = fs.readdirSync(dir);
		for (const file of list) {
			const fullPath = path.join(dir, file);
			const stat = fs.statSync(fullPath);
			if (stat && stat.isDirectory()) {
				results = results.concat(getFiles(fullPath));
			} else if (file.endsWith('.md') && file !== 'curriculum.md' && file !== '01-exam.md') {
				const relativePath = path.relative(vaultPath, fullPath);
				results.push({
					params: { slug: relativePath.replace(/\\/g, '/').replace('.md', '') },
					props: { fullPath }
				});
			}
		}
		return results;
	}

	return getFiles(vaultPath);
}

const { fullPath } = Astro.props;
const content = fs.readFileSync(fullPath, 'utf-8');

// --- Pre-rendering Logic (SSR) ---
function renderInlineMath(text: string): string {
	return text.replace(/\$([^\$\n]+?)\$/g, (_, tex) => {
		try {
			return `<span class="math-inline">${katex.renderToString(tex.trim(), { displayMode: false, output: 'html', throwOnError: false })}</span>`;
		} catch { return tex; }
	});
}

function renderDisplayMath(text: string): string {
	return text.replace(/\$\$(.*?)\$\$/gs, (_, tex) => {
		try {
			return `<div class="math-display">${katex.renderToString(tex.trim(), { displayMode: true, output: 'html', throwOnError: false })}</div>`;
		} catch { return tex; }
	});
}

// Get all files to support cross-linking
function getVaultFiles(dir: string): { relativePath: string; basename: string; fullPath: string }[] {
	let results: any[] = [];
	if (!fs.existsSync(dir)) return results;
	const list = fs.readdirSync(dir);
	for (const file of list) {
		const fullPath = path.join(dir, file);
		const stat = fs.statSync(fullPath);
		if (stat && stat.isDirectory()) {
			results = results.concat(getVaultFiles(fullPath));
		} else if (file.endsWith('.md') && file !== 'curriculum.md' && file !== '01-exam.md') {
			const relativePath = path.relative(path.join(process.cwd(), '../vault'), fullPath);
			const basename = path.basename(file, '.md');
			results.push({ relativePath: relativePath.replace(/\\/g, '/').replace('.md', ''), basename, fullPath });
		}
	}
	return results;
}

const allFiles = getVaultFiles(path.join(process.cwd(), '../vault'));

function parseWikiLinks(text: string) {
	return text.replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, (match, slug, label) => {
		const targetLabel = label || slug;
		const trimmedSlug = slug.trim();
		const matchedFile = allFiles.find(f => f.basename === trimmedSlug || f.relativePath === trimmedSlug);
		if (matchedFile) {
			return `<a href="/h1_math_c1/study/${matchedFile.relativePath}" class="wiki-link">${targetLabel}</a>`;
		}
		return `<span class="wiki-link-broken" title="문서가 존재하지 않습니다.">${targetLabel}</span>`;
	});
}

function processContent(raw: string) {
	// 1. ::: blocks parsing
	const segments = raw.split(':::');
	let cleaned = segments[0];
	
	for (let i = 1; i < segments.length; i += 2) {
		const block = segments[i];
		const nextText = segments[i+1] || '';
		
		const firstNewline = block.indexOf('\n');
		if (firstNewline !== -1) {
			const type = block.substring(0, firstNewline).trim();
			const content = block.substring(firstNewline).trim(); 
			cleaned += `<div class="card ${type}-card">\n${content}\n</div>` + nextText;
		} else {
			cleaned += block + nextText;
		}
	}

	// 2. Standard Markdown processing (badge, strong, quotes, bullets, checkboxes)
	cleaned = cleaned
		.replace(/^## (.*)/gm, '<div class="section-badge-wrapper"><div class="section-badge">$1</div></div>')
		.replace(/^### (.*)/gm, '<h4 class="sub-section-title">$1</h4>')
		.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
		.replace(/==(.*?)==/g, '<mark class="highlight">$1</mark>')
		.replace(/^> (.*)$/gm, '<blockquote>$1</blockquote>')
		.replace(/\* (.*)/g, '<div class="list-bullet-item"><span class="list-bullet">─</span> <span class="list-text">$1</span></div>')
		.replace(/- \[\s*\]\s*(.*)/g, '<div class="checkbox-item"><span class="checkbox-icon">⬜</span> <span class="checkbox-text">$1</span></div>')
		.replace(/- \[\s*x\s*\]\s*(.*)/g, '<div class="checkbox-item checkbox-checked"><span class="checkbox-icon">✅</span> <span class="checkbox-text">$1</span></div>');

	cleaned = cleaned.replace(/★ (.*)/g, '<div class="star-item"><span class="star-icon">★</span> <span class="star-text">$1</span></div>');
	
	const instrHTML = renderInlineMath(cleaned);
	let restHTML = renderDisplayMath(instrHTML);
	
	const parts = restHTML.split(/(<div class="card .*?">.*?<\/div>|<div class="math-display">.*?<\/div>|<span class="math-inline">.*?<\/span>|<span class="katex">.*?<\/span>|<span class="katex-display">.*?<\/span>)/gs);
	restHTML = parts.map(p => {
		if (p.startsWith('<div class="card') || p.startsWith('<div class="math-display">') || p.startsWith('<span class="math-inline') || p.startsWith('<span class="katex') || p.startsWith('<span class="katex-display')) return p;
		return p.replace(/\n/g, '<br/>');
	}).join('');

	restHTML = restHTML.replace(/<\/div><br\/>/g, '</div>').replace(/<\/blockquote><br\/>/g, '</blockquote>').replace(/<\/h4><br\/>/g, '</h4>');

	restHTML = restHTML
		.replace(/<div class="concept-grid"><br\/>/g, '<div class="concept-grid">')
		.replace(/<div class="concept-grid-item"><br\/>/g, '<div class="concept-grid-item">')
		.replace(/<\/div><br\/><div class="concept-grid-item">/g, '</div><div class="concept-grid-item">')
		.replace(/<br\/><\/div><\/div>/g, '</div></div>');

	return parseWikiLinks(restHTML);
}

// Parse Study Page
const lines = content.split('\n');
const title = lines[0].startsWith('# ') ? lines[0].replace('# ', '').trim() : "개념 학습";
const body = lines[0].startsWith('# ') ? lines.slice(1).join('\n').trim() : content;

const section = {
	title,
	content: processContent(body)
};
---

<Layout title={`개념 학습 - ${section.title}`}>
	<div class="paper-stack">
		<div class="paper study-page">
			<div class="content-border">
				<header class="study-header">
					<div class="header-top">
						<div class="nav-group">
							<span class="id-label">고등학교 교과서</span>
							<a href="/h1_math_c1" class="home-link" title="전체 목록보기">🏠</a>
						</div>
						<span class="page-num">02</span>
					</div>
					<h2 class="study-title">{section.title}</h2>
				</header>

				<div class="study-content">
					<div class="concept-section" set:html={section.content}></div>
				</div>

				<footer class="exam-footer">
					<div class="footer-row">
						<span class="brand">대한민국 수학교육 프로젝트</span>
						<span class="copy">ⓒ 2026 Mathematics Education All Rights Reserved</span>
					</div>
				</footer>
			</div>
		</div>
	</div>
</Layout>

<style>
	.paper-stack {
		display: flex;
		justify-content: center;
		width: 100%;
	}

	.study-header {
		border-bottom: 2px solid #1a1a1a;
		margin-bottom: 2.2rem;
		padding: 0.5rem 0 0.8rem 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	.header-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.6rem;
		font-family: 'Noto Serif KR', serif;
	}
	.nav-group {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}
	.home-link {
		text-decoration: none;
		font-size: 1.25rem;
		transition: transform 0.2s;
		display: inline-flex;
	}
	.home-link:hover {
		transform: scale(1.1);
	}
	.id-label {
		font-family: 'Noto Serif KR', serif;
		font-size: 0.85rem;
		font-weight: 500;
		color: #555555;
		letter-spacing: 0.05em;
	}
	.page-num {
		font-size: 0.85rem;
		color: #555555;
		font-family: 'Noto Serif KR', serif;
	}
	.study-title {
		font-family: 'Noto Serif KR', serif;
		font-size: 2.4rem;
		margin: 0.5rem 0 0 0;
		color: #1a1a1a;
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1.3;
		text-align: center;
	}
	@media (max-width: 768px) {
		.study-title {
			font-size: 1.7rem;
		}
		.study-header {
			margin-bottom: 1.4rem;
		}
	}

	.study-content {
		display: flex;
		flex-direction: column;
		gap: 0;
		min-height: 135mm;
		font-family: 'Noto Sans KR', sans-serif;
		color: #1a1a1a;
		line-height: 1.95;
	}

	:global(p) {
		margin: 0 0 0.8rem 0;
		line-height: 1.95;
	}

	:global(.section-badge-wrapper) {
		margin: 1.4rem 0 0.6rem 0;
	}
	:global(.section-badge) {
		display: inline-block;
		border-bottom: 2px solid #a3927d;
		color: #706251;
		font-size: 1.3rem;
		font-weight: 700;
		padding: 0 0 0.2rem 0;
		font-family: 'Noto Serif KR', serif;
	}

	:global(.sub-section-title) {
		font-family: 'Noto Serif KR', serif;
		font-size: 1.1rem;
		font-weight: 700;
		color: #5c4d3c;
		margin: 1rem 0 0.5rem 0;
	}

	:global(.card) {
		padding: 1.35rem 1.6rem;
		margin: 1.2rem 0;
		line-height: 1.95;
		font-size: 1.05rem;
		border: none;
		border-left: 3.5px solid #dfc3a3;
		background: #faf6f0;
		text-align: left;
	}

	:global(.concept-grid) {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: stretch;
		gap: 1.2rem;
		margin: 1.5rem 0;
		width: 100%;
	}
	@media (max-width: 768px) {
		:global(.concept-grid) {
			flex-direction: column;
		}
	}
	:global(.concept-grid > br) {
		display: none !important;
	}
	:global(.concept-grid-item) {
		flex: 1;
		min-width: 0;
		background: #faf6f0;
		border: 1px solid #ebd9c5;
		border-radius: 6px;
		padding: 1.25rem 1.35rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		box-shadow: 0 2px 8px rgba(0,0,0,0.02);
		transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
	}
	:global(.concept-grid-item:hover) {
		transform: translateY(-2.5px);
		box-shadow: 0 5px 15px rgba(0,0,0,0.06);
		border-color: #dfc3a3;
		background: #fdfaf5;
	}
	:global(.concept-grid-item h4) {
		margin: 0 0 0.5rem 0;
		font-size: 1.0rem;
		font-weight: 700;
		line-height: 1.4;
	}
	:global(.concept-grid-item p) {
		margin: 0;
		font-size: 0.95rem;
		color: #4a4135;
		line-height: 1.7;
	}

	:global(.star-item) {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.6rem 0;
	}
	:global(.star-icon) {
		color: #1a1a1a;
		font-size: 0.95rem;
	}
	:global(.star-text) {
		font-size: 1.05rem;
		color: #1a1a1a;
	}

	:global(.checkbox-item) {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.6rem 0;
	}
	:global(.checkbox-icon) {
		font-size: 1.05rem;
	}
	:global(.checkbox-text) {
		font-size: 1.05rem;
	}
	:global(.checkbox-checked .checkbox-text) {
		text-decoration: line-through;
		color: #555555;
	}

	:global(.list-bullet-item) {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.4rem 0;
	}
	:global(.list-bullet) {
		color: #555555;
		font-size: 0.8rem;
	}
	:global(.list-text) {
		font-size: 1.05rem;
		color: #1a1a1a;
	}

	:global(blockquote) {
		margin: 1rem 0 1.5rem 0;
		padding: 1.2rem 1.5rem;
		background: #faf6f0;
		border: none;
		border-left: 3.5px solid #dfc3a3;
		font-weight: 500;
		color: #2c241b;
		font-size: 1.1rem;
		text-align: left;
		letter-spacing: -0.01em;
	}

	:global(.wiki-link) {
		color: #3b5066;
		text-decoration: none;
		font-weight: 600;
		border-bottom: 1.5px solid #a3b8cc;
		transition: all 0.2s;
		padding: 0 1px;
	}
	:global(.wiki-link:hover) {
		color: #2b3d4f;
		background: #e8eff5;
		border-bottom-color: #3b5066;
	}

	:global(mark.highlight), :global(mark) {
		background: #fbf0b9;
		color: #1a1a1a;
		padding: 0 4px;
		border-radius: 2px;
	}

	.exam-footer {
		margin-top: auto;
		padding-top: 1.5rem;
		border-top: 1px solid #dfd7c7;
	}
	.footer-row {
		display: flex;
		justify-content: space-between;
		font-size: 0.8rem;
		font-weight: 500;
		color: #555555;
	}
</style>
