---
import Layout from '../layouts/Layout.astro';
---

<Layout title="소수학 서재 - My Library">
    <main class="library-container">
        <header class="library-header">
            <h1>My Library</h1>
            <p>디지털 수학 교과서 서재에 오신 것을 환영합니다.</p>
        </header>

        <section class="bookshelf">
            <!-- 공통수학 II 책 표지 (클릭 시 flip-demo로 이동) -->
            <a href="/h1_math_c2/flip-demo" class="book-card">
                <div class="book-cover">
                    <span class="subject">High School Mathematics</span>
                    <h2 class="book-title">공통수학 II</h2>
                    <div class="divider"></div>
                    <p class="author">Premium Digital Edition</p>
                </div>
                <div class="book-info">
                    <h3>공통수학 II (상)</h3>
                    <p>저자: 소수학 (昭數學)</p>
                    <span class="open-btn">책 열기 &rarr;</span>
                </div>
            </a>
        </section>
    </main>
</Layout>

<style>
    .library-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 20px;
        font-family: 'Noto Sans KR', sans-serif;
    }

    .library-header {
        text-align: center;
        margin-bottom: 60px;
    }

    .library-header h1 {
        font-size: 3rem;
        color: #2c241d;
        font-family: 'Noto Serif KR', serif;
        margin-bottom: 10px;
    }

    .library-header p {
        color: #666;
        font-size: 1.1rem;
    }

    .bookshelf {
        display: flex;
        flex-wrap: wrap;
        gap: 40px;
        justify-content: center;
    }

    /* 책 카드 컨테이너 */
    .book-card {
        display: block;
        text-decoration: none;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        width: 320px;
    }

    .book-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }

    /* 책 표지 디자인 (flip-demo.astro에서 가져옴) */
    .book-cover {
        background: #2c241d; /* 가죽 질감 느낌의 어두운 갈색 */
        background-image: url('https://www.transparenttextures.com/patterns/leather.png');
        height: 480px; /* 비율 조정 (450 -> 480) */
        padding: 30px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        border: 2px solid #e0c9a6;
        border-radius: 8px 8px 0 0;
        margin: 5px 5px 0 5px;
    }

    .subject {
        color: #e0c9a6;
        font-size: 1rem;
        letter-spacing: 4px;
        text-transform: uppercase;
        border-bottom: 1px solid rgba(224, 201, 166, 0.5);
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    .book-title {
        color: #e0c9a6;
        font-size: 2.8rem;
        font-family: 'Noto Serif KR', serif;
        font-weight: 900;
        line-height: 1.2;
        margin: 0;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .divider {
        width: 60px;
        height: 2px;
        background: #e0c9a6;
        margin: 25px 0;
    }

    .author {
        color: rgba(224, 201, 166, 0.8);
        font-size: 0.9rem;
        letter-spacing: 2px;
    }

    /* 책 정보 영역 */
    .book-info {
        padding: 25px;
        background: #fdfaf5;
    }

    .book-info h3 {
        color: #2c241d;
        font-size: 1.3rem;
        margin: 0 0 10px 0;
    }

    .book-info p {
        color: #666;
        font-size: 0.9rem;
        margin: 0 0 20px 0;
    }

    .open-btn {
        display: inline-block;
        background: #8b7355;
        color: white;
        padding: 10px 20px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: bold;
        transition: background 0.3s;
    }

    .book-card:hover .open-btn {
        background: #2c241d;
    }
</style>
