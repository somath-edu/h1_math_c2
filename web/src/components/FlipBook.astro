---
// web/src/components/FlipBook.astro
interface Props {
    startPage?: number;
    showCover?: boolean;
}

const { startPage = 0, showCover = false } = Astro.props;
---

<div class="flipbook-wrapper">
    <!-- 원본 페이지 소스: 항상 보존됨 -->
    <div id="page-source" style="display:none;">
        <slot />
    </div>

    <!-- 실제 책이 렌더링되는 컨테이너 -->
    <div id="book-container" class="book-container"
         data-start-page={startPage}
         data-show-cover={showCover ? 'true' : 'false'}>
    </div>

    <div class="book-controls">
        <button id="prev-btn">이전 페이지</button>
        <span id="page-info">1 / 1</span>
        <button id="next-btn">다음 페이지</button>
    </div>
</div>

<style>
    .flipbook-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 5px 0; /* 상하 여백 대폭 축소 */
        width: 100%;
        max-width: 100vw;
        margin: 0 auto;
        perspective: 2000px;
    }

    .book-container {
        box-shadow:
            0 20px 60px rgba(0,0,0,0.25),
            0 10px 20px rgba(0,0,0,0.15);
        background-color: #d1c7b7;
        border-radius: 4px;
        position: relative;
        overflow: hidden;
        /* PC 기본 크기 확보 */
        min-width: 300px;
        min-height: 450px;
    }

    :global(.page) {
        background-color: #fefcf0;
        background-image: url('https://www.transparenttextures.com/patterns/paper-fibers.png');
        padding: clamp(10px, 3vw, 48px) clamp(8px, 2.5vw, 44px);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        color: #2c3e50;
        position: relative;
        overflow: hidden;
        font-size: 1.05rem; 
    }
    @media (max-width: 767px) {
        .flipbook-wrapper {
            padding: 0;
        }
        :global(.page) {
            font-size: 1.15rem;
            padding: 15px 12px !important; /* 모바일 내부 여백 최적화 */
        }
        :global(.page-content p) {
            font-size: 1rem !important;
        }
        :global(.formula-highlight) {
            font-size: 1.2rem !important;
        }
    }

    :global(.page-content) {
        height: 100%;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 2;
        padding-bottom: 20px; /* 푸터 여유 공간 축소 */
    }

    /* 책등 효과 (양면 모드용) */
    .book-container::after {
        content: "";
        position: absolute;
        top: 0; left: 50%;
        transform: translateX(-50%);
        width: 40px; height: 100%;
        background: linear-gradient(to right,
            rgba(0,0,0,0.08) 0%,
            rgba(0,0,0,0.02) 40%,
            rgba(0,0,0,0.02) 60%,
            rgba(0,0,0,0.08) 100%);
        z-index: 10;
        pointer-events: none;
    }

    @media (max-width: 767px) {
        .book-container::after { display: none; }
    }

    .book-controls {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 15px; /* 25px -> 15px로 축소 */
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(10px);
        padding: 8px 25px; /* 패딩 축소 */
        border-radius: 40px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    button {
        padding: 10px 20px;
        border: none;
        background: #4a3f35;
        color: white;
        border-radius: 20px;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    button:hover { background: #2c241d; transform: translateY(-2px); }

    #page-info {
        font-family: 'Noto Serif KR', serif;
        font-size: 15px;
        font-weight: 600;
    }
</style>

<script>
    import { PageFlip } from 'page-flip';

    let pageFlipInstance: any = null;

    function buildFlipBook() {
        const container = document.getElementById('book-container');
        const source = document.getElementById('page-source');
        if (!container || !source) return;

        // 1. 기존 인스턴스 파괴 및 컨테이너 비우기
        if (pageFlipInstance) {
            try { pageFlipInstance.destroy(); } catch(e) {}
            pageFlipInstance = null;
        }
        container.innerHTML = '';

        // 2. 원본 소스에서 페이지 복사 (Clone)
        const originalPages = source.querySelectorAll('.page');
        if (originalPages.length === 0) return;
        
        originalPages.forEach(p => {
            container.appendChild(p.cloneNode(true));
        });

        // 3. 현재 화면 크기에 따른 설정
        const isMobile = window.innerWidth < 768;
        const showCover = container.dataset.showCover === 'true';
        const startPage = parseInt(container.dataset.startPage || '0');
        const cw = container.parentElement?.offsetWidth || window.innerWidth;

        const config = isMobile ? {
            width: cw,
            // 화면 전체 높이에서 하단 컨트롤 영역(약 150px)을 제외한 높이를 사용
            height: window.innerHeight - 150,
            size: "fixed" as const,
            usePortrait: true,
            autoSize: false,
            mobileScrollSupport: true
        } : {
            width: 600,
            height: 900,
            size: "stretch" as const,
            usePortrait: false,
            autoSize: true,
            mobileScrollSupport: false
        };

        // 4. 인스턴스 생성
        pageFlipInstance = new PageFlip(container, {
            ...config,
            showCover,
            startPage,
            minWidth: 200, maxWidth: 1000,
            minHeight: 300, maxHeight: 1500,
            maxShadowOpacity: 0.3,
            flippingTime: 800,
            useMouseEvents: false
        });

        // 5. 페이지 로드 및 수학 기호 렌더링
        const clonedPages = container.querySelectorAll('.page');
        pageFlipInstance.loadFromHTML(clonedPages);

        if ((window as any).renderMathInElement) {
            (window as any).renderMathInElement(container, {
                delimiters: [
                    {left: '$$', right: '$$', display: true},
                    {left: '$', right: '$', display: false}
                ],
                throwOnError: false
            });
        }

        if (startPage > 0) pageFlipInstance.turnToPage(startPage);

        // 6. 상태 업데이트
        const updateInfo = () => {
            const el = document.getElementById('page-info');
            if (el && pageFlipInstance) {
                el.innerText = `${pageFlipInstance.getCurrentPageIndex() + 1} / ${pageFlipInstance.getPageCount()}`;
            }
        };
        pageFlipInstance.on('flip', updateInfo);
        updateInfo();
    }

    // 전역 컨트롤 등록 (한 번만)
    function registerControls() {
        document.getElementById('prev-btn')?.addEventListener('click', () => pageFlipInstance?.flipPrev());
        document.getElementById('next-btn')?.addEventListener('click', () => pageFlipInstance?.flipNext());
        
        document.addEventListener('click', (e) => {
            const t = (e.target as HTMLElement).closest('[data-page]');
            if (t && pageFlipInstance) {
                const idx = parseInt(t.getAttribute('data-page') || '');
                if (!isNaN(idx)) pageFlipInstance.flip(idx);
            }
        });
    }

    // 리사이즈 핸들러 (디바운스)
    let resizeTimer: any;
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            // 가로폭이 유의미하게 변했을 때만(임계점 768px 교차 시) 재빌드
            const nowWidth = window.innerWidth;
            if ((lastWidth >= 768 && nowWidth < 768) || (lastWidth < 768 && nowWidth >= 768)) {
                lastWidth = nowWidth;
                buildFlipBook();
            }
        }, 300);
    });

    if (!(window as any).__flipBookInit) {
        (window as any).__flipBookInit = true;
        registerControls();
        document.addEventListener('astro:page-load', buildFlipBook);
        // 초기 실행
        requestAnimationFrame(buildFlipBook);
    }
</script>
