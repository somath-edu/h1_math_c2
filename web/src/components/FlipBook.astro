---
// web/src/components/FlipBook.astro
interface Props {
    startPage?: number;
    showCover?: boolean;
}

const { startPage = 0, showCover = false } = Astro.props;
---

<div class="flipbook-wrapper">
    <!-- 원본 페이지 DOM: PageFlip이 사용하며, 절대 제거하지 않음 -->
    <div id="page-source" style="display:none;">
        <slot />
    </div>
    <div id="book-container" class="book-container"
         data-start-page={startPage}
         data-show-cover={showCover ? 'true' : 'false'}>
    </div>

    <div class="book-controls">
        <button id="prev-btn">이전 페이지</button>
        <span id="page-info">1 / 1</span>
        <button id="next-btn">다음 페이지</button>
    </div>
</div>

<style>
    .flipbook-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 20px 0;
        width: 100%;
        max-width: 98vw;
        margin: 0 auto;
        perspective: 2000px;
    }

    .book-container {
        box-shadow:
            0 20px 60px rgba(0,0,0,0.25),
            0 10px 20px rgba(0,0,0,0.15);
        background-color: #d1c7b7;
        border-radius: 4px;
        position: relative;
        overflow: hidden;
        width: 100%;
    }

    :global(.page) {
        background-color: #fefcf0;
        background-image: url('https://www.transparenttextures.com/patterns/paper-fibers.png');
        padding: clamp(20px, 4vw, 48px) clamp(16px, 3.5vw, 44px);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        color: #2c3e50;
        position: relative;
        overflow: hidden;
    }

    :global(.page-content) {
        height: 100%;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 2;
        padding-bottom: 55px;
    }

    :global(.page.--left) {
        border-right: 1px solid rgba(0,0,0,0.1);
        box-shadow: inset -20px 0 30px rgba(0,0,0,0.03);
    }

    :global(.page.--right) {
        border-left: 1px solid rgba(0,0,0,0.1);
        box-shadow: inset 20px 0 30px rgba(0,0,0,0.03);
    }

    /* 책등 (PC 양면 모드에서만 보임) */
    .book-container::after {
        content: "";
        position: absolute;
        top: 0; left: 50%;
        transform: translateX(-50%);
        width: 40px; height: 100%;
        background: linear-gradient(to right,
            rgba(0,0,0,0.10) 0%,
            rgba(0,0,0,0.02) 40%,
            rgba(0,0,0,0.02) 60%,
            rgba(0,0,0,0.10) 100%);
        z-index: 10;
        pointer-events: none;
    }

    /* 모바일: 책등 숨김, 그림자 제거 */
    @media (max-width: 767px) {
        .book-container::after { display: none; }
        :global(.page.--left), :global(.page.--right) {
            box-shadow: none !important;
            border: none !important;
        }
    }

    .book-controls {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 28px;
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(10px);
        padding: 12px 25px;
        border-radius: 40px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    button {
        padding: 10px 20px;
        border: none;
        background: #4a3f35;
        color: white;
        border-radius: 20px;
        cursor: pointer;
        font-family: 'Noto Sans KR', sans-serif;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    button:hover { background: #2c241d; transform: translateY(-2px); }

    #page-info {
        font-family: 'Noto Serif KR', serif;
        font-size: 15px;
        font-weight: 600;
        color: #4a3f35;
    }

    :global(.toc-link) {
        cursor: pointer !important;
        position: relative;
        z-index: 100;
        pointer-events: auto !important;
        transition: all 0.2s ease;
    }
    :global(.toc-link:hover) {
        background: rgba(139, 115, 85, 0.08) !important;
        transform: translateX(8px);
        color: #8b7355;
    }
</style>

<script>
    import { PageFlip } from 'page-flip';

    const MOBILE_BREAKPOINT = 768; // px

    let pageFlipInstance: any = null;

    function getIsMobile(): boolean {
        return window.innerWidth < MOBILE_BREAKPOINT;
    }

    function buildFlipBook() {
        const container = document.getElementById('book-container') as HTMLElement | null;
        const source    = document.getElementById('page-source')    as HTMLElement | null;
        if (!container || !source) return;

        // ── 이전 인스턴스를 정리하되 DOM은 건드리지 않음 ──
        if (pageFlipInstance) {
            try { pageFlipInstance.destroy(); } catch (_) {}
            pageFlipInstance = null;
        }

        // source 안의 .page 요소를 container 안으로 이동 (최초 1회)
        // → 이미 container 안에 있으면 건너뜀
        const existingPages = container.querySelectorAll('.page');
        if (existingPages.length === 0) {
            const pages = source.querySelectorAll('.page');
            pages.forEach(p => container.appendChild(p));
        }

        const isMobile = getIsMobile();
        const showCover = container.dataset.showCover === 'true';
        const startPage = parseInt(container.dataset.startPage || '0');
        const containerWidth = container.offsetWidth || window.innerWidth * 0.95;

        // ── 설정 분기 ──
        const config = isMobile
            ? {                                   // 모바일: 단면 고정
                width:       Math.max(containerWidth - 4, 200),
                height:      Math.round(Math.max(containerWidth - 4, 200) * 1.5),
                size:        'fixed' as const,
                minWidth:    200,   maxWidth: 600,
                minHeight:   300,   maxHeight: 900,
                usePortrait: true,
                useMouseEvents: false,
                mobileScrollSupport: true,
                maxShadowOpacity: 0.3,
                flippingTime: 700,
              }
            : {                                   // PC: 양면 고정
                width:       600,
                height:      900,
                size:        'stretch' as const,
                minWidth:    315,    maxWidth: 1000,
                minHeight:   420,    maxHeight: 1500,
                usePortrait: false,
                useMouseEvents: true,
                mobileScrollSupport: false,
                maxShadowOpacity: 0.5,
                flippingTime: 1000,
              };

        pageFlipInstance = new PageFlip(container, {
            ...config,
            showCover,
            startPage,
            clickEventForward: false,
            startVelocity: 10,
            autoSize: isMobile ? false : true,
        });

        const pages = container.querySelectorAll('.page');
        pageFlipInstance.loadFromHTML(pages);

        // KaTeX 재렌더링
        if ((window as any).renderMathInElement) {
            (window as any).renderMathInElement(document.body, {
                delimiters: [
                    { left: '$$', right: '$$', display: true },
                    { left: '$',  right: '$',  display: false },
                ],
                throwOnError: false,
            });
        }

        if (startPage > 0) pageFlipInstance.turnToPage(startPage);

        // ── 페이지 정보 ──
        const updateInfo = () => {
            const el = document.getElementById('page-info');
            if (el && pageFlipInstance) {
                el.innerText = `${pageFlipInstance.getCurrentPageIndex() + 1} / ${pageFlipInstance.getPageCount()}`;
            }
        };
        pageFlipInstance.on('flip', updateInfo);
        updateInfo();
    }

    // ── 버튼/목차 이벤트 (한 번만 등록) ──
    function registerControls() {
        document.getElementById('prev-btn')?.addEventListener('click', () => {
            pageFlipInstance?.flipPrev();
        });
        document.getElementById('next-btn')?.addEventListener('click', () => {
            pageFlipInstance?.flipNext();
        });
        document.addEventListener('click', (e) => {
            const t = (e.target as HTMLElement).closest('[data-page]');
            if (t && pageFlipInstance) {
                const idx = parseInt(t.getAttribute('data-page') || '');
                if (!isNaN(idx)) pageFlipInstance.flip(idx);
            }
        });
    }

    // ── 리사이즈: breakpoint 교차 시에만 재빌드 ──
    let _wasMobile = getIsMobile();
    let _resizeTimer: ReturnType<typeof setTimeout> | null = null;

    function onResize() {
        if (_resizeTimer) clearTimeout(_resizeTimer);
        _resizeTimer = setTimeout(() => {
            const nowMobile = getIsMobile();
            if (nowMobile !== _wasMobile) {
                _wasMobile = nowMobile;
                buildFlipBook();
            }
        }, 250);
    }

    // ── 진입점 (이중 초기화 방지) ──
    function init() {
        requestAnimationFrame(() => {
            buildFlipBook();
        });
    }

    if (!(window as any).__flipBookReady) {
        (window as any).__flipBookReady = true;
        registerControls();
        window.addEventListener('resize', onResize);
        document.addEventListener('astro:page-load', init);
        init();
    }
</script>
