---
// web/src/components/FlipBook.astro
interface Props {
    startPage?: number;
    showCover?: boolean;
}

const { startPage = 0, showCover = false } = Astro.props;
---

<div class="flipbook-wrapper">
    <div id="book-container" class="book-container" data-start-page={startPage} data-show-cover={showCover ? 'true' : 'false'}>
        <!-- 페이지들이 이곳에 들어갑니다 -->
        <slot />
    </div>
    
    <div class="book-controls">
        <button id="prev-btn">이전 페이지</button>
        <span id="page-info">1 / 1</span>
        <button id="next-btn">다음 페이지</button>
    </div>
</div>

<style>
    .flipbook-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 20px 0;
        width: 100%;
        max-width: 95vw;
        margin: 0 auto;
        perspective: 2000px;
    }

    .book-container {
        box-shadow: 
            0 20px 60px rgba(0,0,0,0.25), 
            0 10px 20px rgba(0,0,0,0.15);
        background-color: #d1c7b7;
        border-radius: 4px;
        position: relative;
        overflow: hidden;
    }

    /* 각 페이지의 프리미엄 아날로그 스타일 */
    :global(.page) {
        background-color: #fefcf0;
        background-image: url('https://www.transparenttextures.com/patterns/paper-fibers.png');
        padding: clamp(25px, 5vw, 50px) clamp(20px, 4vw, 45px);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        color: #2c3e50;
        position: relative;
        overflow: hidden;
    }

    :global(.page-content) {
        height: 100%;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 2;
        padding-bottom: 60px;
    }

    /* 왼쪽 페이지 그림자 */
    :global(.page.--left) {
        border-right: 1px solid rgba(0,0,0,0.1);
        box-shadow: inset -20px 0 30px rgba(0,0,0,0.03);
    }

    /* 오른쪽 페이지 그림자 */
    :global(.page.--right) {
        border-left: 1px solid rgba(0,0,0,0.1);
        box-shadow: inset 20px 0 30px rgba(0,0,0,0.03);
    }

    /* 가운데 책등(Spine) 효과 */
    .book-container::after {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 100%;
        background: linear-gradient(to right, 
            rgba(0,0,0,0.1) 0%, 
            rgba(0,0,0,0.02) 40%, 
            rgba(0,0,0,0.02) 60%, 
            rgba(0,0,0,0.1) 100%);
        z-index: 10;
        pointer-events: none;
    }

    /* 모바일: 책등 제거 */
    @media (max-width: 768px) {
        .flipbook-wrapper {
            padding: 10px 0;
        }
        .book-container::after {
            display: none;
        }
        :global(.page.--left), :global(.page.--right) {
            box-shadow: none !important;
            border: none !important;
        }
    }

    .book-controls {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 30px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        padding: 12px 25px;
        border-radius: 40px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    button {
        padding: 10px 20px;
        border: none;
        background: #4a3f35;
        color: white;
        border-radius: 20px;
        cursor: pointer;
        font-family: 'Noto Sans KR', sans-serif;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    button:hover {
        background: #2c241d;
        transform: translateY(-2px);
    }

    #page-info {
        font-family: 'Noto Serif KR', serif;
        font-size: 15px;
        font-weight: 600;
        color: #4a3f35;
    }

    /* 목차 링크 스타일 */
    :global(.toc-link) {
        cursor: pointer !important;
        position: relative;
        z-index: 100;
        pointer-events: auto !important;
        transition: all 0.2s ease;
    }
    :global(.toc-link:hover) {
        background: rgba(139, 115, 85, 0.08) !important;
        transform: translateX(8px);
        color: #8b7355;
    }
</style>

<script>
    import { PageFlip } from 'page-flip';

    function initFlipBook() {
        const htmlElement = document.getElementById('book-container');
        if (!htmlElement) return;

        const showCover = htmlElement.dataset.showCover === 'true';
        const startPage = parseInt(htmlElement.dataset.startPage || '0');

        // 레이아웃이 완성된 후 컨테이너 크기를 측정하기 위해 rAF 사용
        requestAnimationFrame(() => {
            const pageFlip = new PageFlip(htmlElement, {
                width: 600,         // portrait 자동 전환 기준: container < 600px → 단면
                height: 900,
                size: "stretch",    // 컨테이너에 맞게 자동 조절
                minWidth: 200,
                maxWidth: 1000,
                minHeight: 300,
                maxHeight: 1500,
                maxShadowOpacity: 0.5,
                showCover: showCover,
                startPage: startPage,
                mobileScrollSupport: true,
                clickEventForward: false,
                usePortrait: true,  // 화면이 좁으면 자동으로 단면 전환
                useMouseEvents: true,
                startVelocity: 10,
                flippingTime: 1000,
            });

            const pages = document.querySelectorAll('.page');
            if (pages.length > 0) {
                pageFlip.loadFromHTML(pages);

                if ((window as any).renderMathInElement) {
                    (window as any).renderMathInElement(document.body, {
                        delimiters: [
                            { left: '$$', right: '$$', display: true },
                            { left: '$', right: '$', display: false }
                        ],
                        throwOnError: false
                    });
                }

                if (startPage > 0) pageFlip.turnToPage(startPage);
            }

            const updatePageInfo = () => {
                const el = document.getElementById('page-info');
                if (el) el.innerText = `${pageFlip.getCurrentPageIndex() + 1} / ${pageFlip.getPageCount()}`;
            };

            pageFlip.on('flip', () => updatePageInfo());
            updatePageInfo();

            document.getElementById('prev-btn')?.addEventListener('click', () => pageFlip.flipPrev());
            document.getElementById('next-btn')?.addEventListener('click', () => pageFlip.flipNext());

            document.addEventListener('click', (e) => {
                const target = (e.target as HTMLElement).closest('[data-page]');
                if (target) {
                    const idx = parseInt(target.getAttribute('data-page') || '');
                    if (!isNaN(idx)) pageFlip.flip(idx);
                }
            });
        });
    }

    // 이중 초기화 방지 guard
    if (!(window as any).__flipBookInit) {
        (window as any).__flipBookInit = true;
        document.addEventListener('astro:page-load', initFlipBook);
        initFlipBook();
    }
</script>
