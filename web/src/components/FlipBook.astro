---
// web/src/components/FlipBook.astro
interface Props {
    startPage?: number;
}

const { startPage = 0 } = Astro.props;
---

<div class="flipbook-wrapper">
    <div id="book-container" class="book-container" data-start-page={startPage}>
        <!-- 페이지들이 이곳에 들어갑니다 -->
        <slot />
    </div>
    
    <div class="book-controls">
        <button id="prev-btn">이전 페이지</button>
        <span id="page-info">1 / 1</span>
        <button id="next-btn">다음 페이지</button>
    </div>
</div>

<style>
    .flipbook-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px 0;
        width: 100%;
        max-width: 95vw; /* 화면 너비의 95%까지 활용 */
        margin: 0 auto;
        perspective: 2000px;
    }

    .book-container {
        box-shadow: 
            0 20px 60px rgba(0,0,0,0.25), 
            0 10px 20px rgba(0,0,0,0.15);
        background-color: #d1c7b7;
        border-radius: 4px;
        position: relative;
        overflow: hidden; /* 영역 밖으로 나가는 것 방지 */
    }

    /* 각 페이지의 프리미엄 아날로그 스타일 */
    :global(.page) {
        background-color: #fefcf0; /* 따뜻한 미색 종이 */
        background-image: url('https://www.transparenttextures.com/patterns/paper-fibers.png'); /* 미세 종이 질감 */
        padding: clamp(25px, 5vw, 50px) clamp(20px, 4vw, 45px);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        color: #2c3e50;
        position: relative;
    }

    /* 페이지 내부의 은은한 입체 그림자 (책이 접히는 부분) */
    :global(.page-content) {
        height: 100%;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 2;
        padding-bottom: 60px; /* 더 넓은 안전 공간 확보 (60px) */
    }

    /* 왼쪽 페이지 그림자 (오른쪽이 어두움) */
    :global(.page.--left) {
        border-right: 1px solid rgba(0,0,0,0.1);
        box-shadow: inset -20px 0 30px rgba(0,0,0,0.03);
    }

    /* 오른쪽 페이지 그림자 (왼쪽이 어두움) */
    :global(.page.--right) {
        border-left: 1px solid rgba(0,0,0,0.1);
        box-shadow: inset 20px 0 30px rgba(0,0,0,0.03);
    }

    /* 가운데 책등(Spine) 효과: 펼침 모드에서만 표시 */
    .book-container::after {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 100%;
        background: linear-gradient(to right, 
            rgba(0,0,0,0.1) 0%, 
            rgba(0,0,0,0.02) 40%, 
            rgba(0,0,0,0.02) 60%, 
            rgba(0,0,0,0.1) 100%);
        z-index: 10;
        pointer-events: none;
    }

    /* 모바일/단면 모드일 때 그림자 및 책등 제거 */
    @media (max-width: 768px) {
        .book-container::after {
            display: none; /* 가운데 바 삭제 */
        }
        :global(.page.--left), :global(.page.--right) {
            box-shadow: none !important; /* 안쪽 그림자 삭제 */
            border: none !important;
        }
    }

    .book-controls {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 30px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        padding: 12px 25px;
        border-radius: 40px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    button {
        padding: 10px 20px;
        border: none;
        background: #4a3f35;
        color: white;
        border-radius: 20px;
        cursor: pointer;
        font-family: 'Noto Sans KR', sans-serif;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    button:hover {
        background: #2c241d;
        transform: translateY(-2px);
    }

    #page-info {
        font-family: 'Noto Serif KR', serif;
        font-size: 15px;
        font-weight: 600;
        color: #4a3f35;
    }

    /* 목차 링크 스타일 */
    :global(.toc-link) {
        cursor: pointer !important;
        position: relative;
        z-index: 100;
        pointer-events: auto !important;
        transition: all 0.2s ease;
    }
    :global(.toc-link:hover) {
        background: rgba(139, 115, 85, 0.08) !important;
        transform: translateX(8px);
        color: #8b7355;
    }
</style>

<script>
    import { PageFlip } from 'page-flip';

    function initFlipBook() {
        const htmlElement = document.getElementById('book-container');
        if (!htmlElement) return;

        const startPage = parseInt(htmlElement.dataset.startPage || '0');

        const pageFlip = new PageFlip(htmlElement, {
            width: 600, // 기본 페이지 가로 크기 확대
            height: 800, // 기본 페이지 세로 크기 확대
            size: "stretch",
            minWidth: 315,
            maxWidth: 1000,
            minHeight: 420,
            maxHeight: 1350,
            maxShadowOpacity: 0.5,
            showCover: true,
            startPage: startPage,
            mobileScrollSupport: true, // 모바일 스크롤 지원 활성화
            clickEventForward: false, // 클릭 이벤트 전달 비활성화
            usePortrait: true, // 모바일에서 단면 보기 자동 전환 활성화
            startVelocity: 10,
            flippingTime: 1000,
            useMouseEvents: false // 마우스 이벤트 비활성화
        });

        // 페이지 데이터 로드
        const pages = document.querySelectorAll('.page');
        if (pages.length > 0) {
            pageFlip.loadFromHTML(document.querySelectorAll('.page'));
            
            // 수학 기호(KaTeX) 수동 재렌더링 강제 실행
            if ((window as any).renderMathInElement) {
                (window as any).renderMathInElement(document.body, {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false}
                    ],
                    throwOnError: false
                });
            }
            
            // 시작 페이지로 강제 이동 (Index 기반이므로 확실히 처리)
            if (startPage > 0) {
                pageFlip.turnToPage(startPage);
            }
        }

        // 페이지 정보 업데이트
        const updatePageInfo = () => {
            const pageInfo = document.getElementById('page-info');
            if (pageInfo) {
                // 실제 인덱스가 아닌 사용자에게 보이는 페이지 번호로 계산
                pageInfo.innerText = `${pageFlip.getCurrentPageIndex() + 1} / ${pageFlip.getPageCount()}`;
            }
        };

        // 이벤트 리스너
        pageFlip.on('flip', (e: any) => {
            updatePageInfo();
        });

        document.getElementById('prev-btn')?.addEventListener('click', () => {
            pageFlip.flipPrev();
        });

        document.getElementById('next-btn')?.addEventListener('click', () => {
            pageFlip.flipNext();
        });

        // 목차 클릭 리스너
        document.addEventListener('click', (e) => {
            const target = (e.target as HTMLElement).closest('[data-page]');
            if (target) {
                const pageIndex = parseInt(target.getAttribute('data-page') || '');
                if (!isNaN(pageIndex)) pageFlip.flip(pageIndex);
            }
        });

        updatePageInfo();
    }

    // Astro 페이지 로드 시 실행
    document.addEventListener('astro:page-load', initFlipBook);
    // 초기 로드 시 실행 (View Transitions 미사용 시 대비)
    initFlipBook();
</script>
