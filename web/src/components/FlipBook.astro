---
// web/src/components/FlipBook.astro
interface Props {
    startPage?: number;
    showCover?: boolean;
}

const { startPage = 0, showCover = false } = Astro.props;
---

<div class="flipbook-wrapper">
    <div id="book-container" class="book-container" data-start-page={startPage} data-show-cover={showCover ? 'true' : 'false'}>
        <!-- 페이지들이 이곳에 들어갑니다 -->
        <slot />
    </div>
    
    <div class="book-controls">
        <button id="prev-btn">이전 페이지</button>
        <span id="page-info">1 / 1</span>
        <button id="next-btn">다음 페이지</button>
    </div>
</div>

<style>
    .flipbook-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 20px 0;
        width: 100%;
        max-width: 95vw;
        margin: 0 auto;
        perspective: 2000px;
        /* 모바일에서 최소 높이 확보 */
        min-height: 60vh;
    }

    .book-container {
        box-shadow: 
            0 20px 60px rgba(0,0,0,0.25), 
            0 10px 20px rgba(0,0,0,0.15);
        background-color: #d1c7b7;
        border-radius: 4px;
        position: relative;
        overflow: hidden; /* 페이지 넘김 시 콘텐츠가 삐져나오는 것 방지 */
    }

    /* 각 페이지의 프리미엄 아날로그 스타일 */
    :global(.page) {
        background-color: #fefcf0; /* 따뜻한 미색 종이 */
        background-image: url('https://www.transparenttextures.com/patterns/paper-fibers.png'); /* 미세 종이 질감 */
        padding: clamp(25px, 5vw, 50px) clamp(20px, 4vw, 45px);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        color: #2c3e50;
        position: relative;
        overflow: hidden; /* 페이지 내에서 절대 넘치지 않게 설정 */
    }

    /* 페이지 내부의 은은한 입체 그림자 (책이 접히는 부분) */
    :global(.page-content) {
        height: 100%;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 2;
        padding-bottom: 60px; /* 더 넓은 안전 공간 확보 (60px) */
    }

    /* 왼쪽 페이지 그림자 (오른쪽이 어두움) */
    :global(.page.--left) {
        border-right: 1px solid rgba(0,0,0,0.1);
        box-shadow: inset -20px 0 30px rgba(0,0,0,0.03);
    }

    /* 오른쪽 페이지 그림자 (왼쪽이 어두움) */
    :global(.page.--right) {
        border-left: 1px solid rgba(0,0,0,0.1);
        box-shadow: inset 20px 0 30px rgba(0,0,0,0.03);
    }

    /* 가운데 책등(Spine) 효과: 펼침 모드에서만 표시 */
    .book-container::after {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 100%;
        background: linear-gradient(to right, 
            rgba(0,0,0,0.1) 0%, 
            rgba(0,0,0,0.02) 40%, 
            rgba(0,0,0,0.02) 60%, 
            rgba(0,0,0,0.1) 100%);
        z-index: 10;
        pointer-events: none;
    }

    /* 모바일/단면 모드일 때 그림자 및 책등 제거 */
    @media (max-width: 768px) {
        .flipbook-wrapper {
            padding: 10px 0;
            min-height: auto;
        }
        .book-container {
            /* 모바일에서 화면 높이에 맞춰 최대 크기 제한 */
            max-height: 80vh; 
        }
        .book-container::after {
            display: none; /* 가운데 바 삭제 */
        }
        :global(.page.--left), :global(.page.--right) {
            box-shadow: none !important; /* 안쪽 그림자 삭제 */
            border: none !important;
        }
    }

    .book-controls {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 30px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        padding: 12px 25px;
        border-radius: 40px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    button {
        padding: 10px 20px;
        border: none;
        background: #4a3f35;
        color: white;
        border-radius: 20px;
        cursor: pointer;
        font-family: 'Noto Sans KR', sans-serif;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    button:hover {
        background: #2c241d;
        transform: translateY(-2px);
    }

    #page-info {
        font-family: 'Noto Serif KR', serif;
        font-size: 15px;
        font-weight: 600;
        color: #4a3f35;
    }

    /* 목차 링크 스타일 */
    :global(.toc-link) {
        cursor: pointer !important;
        position: relative;
        z-index: 100;
        pointer-events: auto !important;
        transition: all 0.2s ease;
    }
    :global(.toc-link:hover) {
        background: rgba(139, 115, 85, 0.08) !important;
        transform: translateX(8px);
        color: #8b7355;
    }
</style>

<script>
    import { PageFlip } from 'page-flip';

    let flipBookInstance: any = null;
    let resizeTimer: ReturnType<typeof setTimeout> | null = null;

    function destroyFlipBook() {
        if (flipBookInstance) {
            try { flipBookInstance.destroy(); } catch(e) {}
            flipBookInstance = null;
        }
    }

    function createFlipBook() {
        const htmlElement = document.getElementById('book-container');
        if (!htmlElement) return;

        // 이미 초기화된 인스턴스 제거
        destroyFlipBook();

        const showCover = htmlElement.dataset.showCover === 'true';
        const startPage = parseInt(htmlElement.dataset.startPage || '0');

        // 레이아웃 완성 후 측정하도록 rAF 사용
        requestAnimationFrame(() => {
            const containerWidth = htmlElement.offsetWidth;

            // 좁은 화면에서는 width를 줄여서 portrait 전환이 확실히 되도록 함
            const pageWidth = containerWidth < 600 ? Math.max(containerWidth - 10, 200) : 600;

            flipBookInstance = new PageFlip(htmlElement, {
                width: pageWidth,
                height: Math.round(pageWidth * 1.5), // 2:3 비율 유지
                size: "fixed",          // fixed 모드: 명시적 크기로 portrait 전환 안정화
                minWidth: 200,
                maxWidth: 1000,
                minHeight: 300,
                maxHeight: 1500,
                maxShadowOpacity: 0.5,
                showCover: showCover,
                startPage: startPage,
                mobileScrollSupport: true,
                clickEventForward: false,
                usePortrait: true,
                autoSize: false,
                startVelocity: 10,
                flippingTime: 800,
                useMouseEvents: false
            });

            const pages = document.querySelectorAll('.page');
            if (pages.length > 0) {
                flipBookInstance.loadFromHTML(pages);

                if ((window as any).renderMathInElement) {
                    (window as any).renderMathInElement(document.body, {
                        delimiters: [
                            {left: '$$', right: '$$', display: true},
                            {left: '$', right: '$', display: false}
                        ],
                        throwOnError: false
                    });
                }

                if (startPage > 0) {
                    flipBookInstance.turnToPage(startPage);
                }
            }

            const updatePageInfo = () => {
                const pageInfo = document.getElementById('page-info');
                if (pageInfo && flipBookInstance) {
                    pageInfo.innerText = `${flipBookInstance.getCurrentPageIndex() + 1} / ${flipBookInstance.getPageCount()}`;
                }
            };

            flipBookInstance.on('flip', () => updatePageInfo());
            updatePageInfo();

            // 이전 버튼/다음 버튼 (중복 등록 방지를 위해 클론으로 교체)
            const prevBtn = document.getElementById('prev-btn');
            const nextBtn = document.getElementById('next-btn');
            if (prevBtn) {
                const newPrev = prevBtn.cloneNode(true) as HTMLElement;
                prevBtn.parentNode?.replaceChild(newPrev, prevBtn);
                newPrev.addEventListener('click', () => flipBookInstance?.flipPrev());
            }
            if (nextBtn) {
                const newNext = nextBtn.cloneNode(true) as HTMLElement;
                nextBtn.parentNode?.replaceChild(newNext, nextBtn);
                newNext.addEventListener('click', () => flipBookInstance?.flipNext());
            }
        });
    }

    function initFlipBook() {
        createFlipBook();

        // 창 크기 변경 시 다시 초기화 (디바운스 300ms)
        window.removeEventListener('resize', handleResize);
        window.addEventListener('resize', handleResize);
    }

    function handleResize() {
        if (resizeTimer) clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            createFlipBook();
        }, 300);
    }

    // 목차 클릭 (전역 등록은 한 번만)
    document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('[data-page]');
        if (target && flipBookInstance) {
            const pageIndex = parseInt(target.getAttribute('data-page') || '');
            if (!isNaN(pageIndex)) flipBookInstance.flip(pageIndex);
        }
    });

    // 단 한 번만 실행되도록 guard
    if (!(window as any).__flipBookReady) {
        (window as any).__flipBookReady = true;
        document.addEventListener('astro:page-load', initFlipBook);
        initFlipBook();
    }
</script>
